// =====================================================================
// SPM Math Master — Prisma Schema
// PostgreSQL-compatible (swap provider to "postgresql" for production)
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Students ---------------------------------------------------------
model Student {
  id           String   @id
  displayName  String
  email        String?  @unique
  photoUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  quizAttempts    QuizAttempt[]
  lessonProgress  LessonProgress[]
}

// ---- Subjects (Matematik / Matematik Tambahan) ------------------------
model Subject {
  id          String   @id @default(cuid())
  slug        String   @unique
  nameEn      String
  nameMs      String
  descEn      String
  descMs      String
  icon        String
  color       String
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  topics      Topic[]
}

// ---- Topics -----------------------------------------------------------
model Topic {
  id          String   @id @default(cuid())
  subjectId   String
  slug        String
  order       Int      @default(0)
  titleEn     String
  titleMs     String
  summaryEn   String
  summaryMs   String
  icon        String
  formLevel   Int      @default(5)
  durationMin Int      @default(15)
  createdAt   DateTime @default(now())

  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  quizQuestions QuizQuestion[]
  spmQuestions  SpmQuestion[]
  formulas      Formula[]

  @@unique([subjectId, slug])
}

// ---- Lessons ----------------------------------------------------------
model Lesson {
  id          String   @id @default(cuid())
  topicId     String
  order       Int      @default(0)
  titleEn     String
  titleMs     String
  summaryEn   String
  summaryMs   String
  durationMin Int      @default(8)
  createdAt   DateTime @default(now())

  topic       Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  sections    LessonSection[]

  @@unique([topicId, order])
}

model LessonSection {
  id        String @id @default(cuid())
  lessonId  String
  order     Int    @default(0)
  type      String
  titleEn   String
  titleMs   String
  bodyEn    String
  bodyMs    String
  payload   String?

  lesson    Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

// ---- Formulas ---------------------------------------------------------
model Formula {
  id          String   @id @default(cuid())
  topicId     String
  nameEn      String
  nameMs      String
  formulaLatex String
  formulaDisplay String
  descEn      String
  descMs      String
  exampleEn   String?
  exampleMs   String?
  createdAt   DateTime @default(now())

  topic       Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

// ---- Quiz Questions ---------------------------------------------------
model QuizQuestion {
  id         String   @id @default(cuid())
  topicId    String
  type       String
  promptEn   String
  promptMs   String
  optionsEn  String
  optionsMs  String
  answerKey  String
  explanationEn String
  explanationMs String
  difficulty String   @default("beginner")
  points     Int      @default(1)
  createdAt  DateTime @default(now())

  topic      Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  attempts   QuizAttempt[]
}

// ---- SPM Past-Year Questions ------------------------------------------
model SpmQuestion {
  id            String   @id @default(cuid())
  topicId       String
  year          Int
  paper         Int      @default(2)
  questionNo    String
  promptEn      String
  promptMs      String
  marksEn       String
  marksMs       String
  answerEn      String
  answerMs      String
  workingEn     String?
  workingMs     String?
  createdAt     DateTime @default(now())

  topic         Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

// ---- Quiz Attempts ----------------------------------------------------
model QuizAttempt {
  id          String   @id @default(cuid())
  studentId   String
  questionId  String
  selectedAnswer String
  isCorrect   Boolean
  pointsEarned Int    @default(0)
  createdAt   DateTime @default(now())

  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  question    QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

// ---- Lesson Progress --------------------------------------------------
model LessonProgress {
  id           String   @id @default(cuid())
  studentId    String
  topicId      String
  lessonId     String
  status       String   @default("not_started")
  completionPct Int     @default(0)
  lastSectionIdx Int    @default(0)
  updatedAt    DateTime @updatedAt

  student      Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
}
